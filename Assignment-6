#include <stdio.h>

int fact_rec(int n) {
    if (n == 0) {
        return 1;
    }
    return n * fact_rec(n - 1);
}

int main() {
    int n, i, fact = 1;

    printf("Enter a number: ");
    scanf("%d", &n);

    for (i = 1; i <= n; i++) {
        fact = fact * i;
    }

    printf("Factorial without recursion: %d\n", fact);
    printf("Factorial with recursion: %d\n", fact_rec(n));

    return 0;
}
